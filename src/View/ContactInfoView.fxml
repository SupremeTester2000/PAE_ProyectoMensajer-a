<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.ContactInfoController"
            style="-fx-background-color: #f5f7fb;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">

            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Button fx:id="btnBack"
                    text="← Volver"
                    onAction="#goBack"
                    style="-fx-background-color: #eef2ff;
                           -fx-text-fill: #2563eb;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;" />

            <Label text="Información de Contacto"
                   style="-fx-font-size: 22px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1f2937;" />
        </HBox>
    </top>

    <center>

        <VBox alignment="TOP_CENTER"
              spacing="15">

            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <ImageView fx:id="imgProfile"
                       fitHeight="130"
                       fitWidth="130"
                       preserveRatio="true" />

            <Label fx:id="lblName"
                   text="Nombre Usuario"
                   wrapText="true"
                   maxWidth="320"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-alignment: center;
                          -fx-text-fill: #111827;" />

            <Label fx:id="lblStatus"
                   text="En línea"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #10b981;
                          -fx-font-weight: bold;" />

            <Separator />

            <VBox spacing="8"
                  maxWidth="350">

                <Label text="Correo electrónico"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #6b7280;
                              -fx-font-weight: bold;" />

                <Label fx:id="lblEmail"
                       text="correo@ejemplo.com"
                       style="-fx-font-size: 16px;
                              -fx-text-fill: #111827;" />

            </VBox>

            <Separator />

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnBlock"
                    text="Bloquear contacto"
                    onAction="#blockContact"
                    prefWidth="220"
                    prefHeight="40"
                    style="-fx-background-color: #ef4444;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;" />

        </VBox>

    </center>

</BorderPane>